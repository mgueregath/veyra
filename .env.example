# Copia a .env y ajusta. Todas las variables llevan el prefijo LABELHUB_.
LABELHUB_DATABASE_URL=postgresql+psycopg2://labelhub:labelhub_dev@127.0.0.1:55433/labelhub
LABELHUB_SECRET_KEY=cambia-esto-en-produccion        # firma de las sesiones: largo y secreto

# Dónde están las imágenes de los frames (se referencian en su sitio, no se copian)
LABELHUB_MEDIA_ROOT=/ruta/a/las/imagenes
# Lo que escribe la plataforma
LABELHUB_EXPORT_ROOT=data/exports
LABELHUB_MODELS_ROOT=data/models
LABELHUB_RUNS_ROOT=data/runs

# Entrenamiento, inferencia y detección en vivo corren como procesos aparte con un Python que tenga PyTorch
LABELHUB_TRAIN_PYTHON=/usr/bin/python3
LABELHUB_PRETRAINED_DIRS=/ruta/a/pesos:/otra/ruta       # donde buscar yolov8n.pt, yolov8s.pt…
LABELHUB_DEVICE=0                                       # GPU (o «cpu»)
LABELHUB_LIVE_MAX=2                                     # sesiones en vivo simultáneas
LABELHUB_LIVE_ALLOWED_HOSTS=                            # vacío = cualquier host; o «192.168.1.20,camara.local»
# Para el detector de apariencia del proyecto de piojos (plugins/piojos_blob.py)
LICE_MOTION_SRC=/ruta/a/cv-residue-diff/src
